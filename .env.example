# Shorts Clipper Environment Configuration
# Copy this file to .env and fill in your values.
# See README.md for full documentation of each variable.

# ---------------------------------------------------------
# Required
# ---------------------------------------------------------
# Google Gemini API key (metadata generation + semantic validation)
GEMINI_API_KEY=

# ---------------------------------------------------------
# Publishing — YouTube (OAuth2)
# ---------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: YouTube Data API key (helps Scout avoid yt-dlp rate limits)
# YOUTUBE_API_KEY=

# ---------------------------------------------------------
# Publishing — Instagram (Graph API)
# ---------------------------------------------------------
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# ---------------------------------------------------------
# Publishing — TikTok (Content Posting API, Direct Post)
# ---------------------------------------------------------
# App credentials + user access token (required)
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_ACCESS_TOKEN=
# Optional: user open id (used to build the public video URL)
# TT_OPEN_ID=

# Public URL where the web server is reachable (required for Instagram
# unless SHORTS_USE_TEMP_HOSTS is enabled)
# PUBLIC_URL=https://your-domain.com

# Set to true to use temporary file hosting instead of PUBLIC_URL
# SHORTS_USE_TEMP_HOSTS=false

# ---------------------------------------------------------
# GPU / Hardware Acceleration
# ---------------------------------------------------------
# SHORTS_ENABLE_GPU=false
# For Russian + English support use a multilingual Whisper model.
# distil-large-v3 (~1.6GB int8) supports ru + en on CPU (~min 4 cores).
# tiny.en is English-only and is the current runtime default.
# SHORTS_WHISPER_MODEL=distil-large-v3
# Language hint for Whisper: "auto", "ru", "en", or empty for auto-detect.
# SHORTS_WHISPER_LANGUAGE=auto
# SHORTS_WHISPER_DEVICE=cpu
# SHORTS_WHISPER_COMPUTE_TYPE=int8
# SHORTS_VIDEO_CODEC=libx264
# SHORTS_VIDEO_PRESET=ultrafast

# ---------------------------------------------------------
# Pipeline Settings
# ---------------------------------------------------------
# SHORTS_SCOUT_MAX_AGE_DAYS=90
# SHORTS_SUBTITLE_STYLE=default
# Comma-separated subtitle languages to fetch from YouTube (ISO 639-1 codes).
# SHORTS_SUBTITLE_LANGS=ru,en
# SHORTS_PUBLISH_PLATFORMS=youtube,instagram
# SHORTS_PROVIDER=gemini
# SHORTS_LOG_LEVEL=INFO
# SHORTS_OUTPUT_DIR=outputs
# SHORTS_CACHE_DIR=.cache/shorts-clipper
# SHORTS_MODELS_DIR=models
# SHORTS_PROXY=
#
# ---------------------------------------------------------
# Affiliate / Partner module
# ---------------------------------------------------------
# Enables config-driven affiliate partners (CS:GO skin links, banners).
# AFFILIATE_ENABLED=false
# JSON file with the partner list (see affiliate_partners.json).
# AFFILIATE_PARTNERS_PATH=affiliate_partners.json
# Banner placement on the rendered short:
# bottom_left | bottom_right | top_left | top_right
# AFFILIATE_BANNER_POSITION=bottom_left
# Show a timed mid-roll affiliate brand card overlay during the short.
# SHORTS_AFFILIATE_AD_CARD=false
# When the ad card appears (fraction of clip duration, 0.0–1.0).
# SHORTS_AFFILIATE_AD_START_FRACTION=0.45
# How long the ad card is visible in seconds.
# SHORTS_AFFILIATE_AD_DURATION_SEC=4.0
# CTA text shown below the card. Empty = auto-generate "<PartnerName> — скины CS2, ссылка в описании"
# SHORTS_AFFILIATE_CTA_TEXT=
#
# --- Audio-energy highlight judge (stream VODs) ---
# Favor energetic/crowd-reaction moments; penalize dead air.
# Cheap CPU-only RMS analysis via ffmpeg.
# SHORTS_STREAM_AUDIO_ENERGY=true
# SHORTS_STREAM_ENERGY_WINDOW=1.0
# SHORTS_STREAM_ENERGY_THRESHOLD=0.15
#
# --- Gameplay mode (no subtitles — CS2/CS:GO VODs, frag/hype) ---
# Selects clip windows by AUDIO ENERGY instead of subtitles.
# When enabled, PASS 1 bypasses semantic candidate generation and picks
# the most energetic windows directly from a downloaded audio sample.
# SHORTS_GAMEPLAY_MODE=false
# Cap on how many seconds of audio are analyzed (0..N). Long VODs cost a lot.
# SHORTS_GAMEPLAY_SCAN_MAX_SECONDS=3600
# Number of top-energy clip windows to preselect.
# SHORTS_GAMEPLAY_TOP_WINDOWS=5
# Minimum / maximum clip length (seconds) for an energy cluster.
# SHORTS_GAMEPLAY_MIN_LENGTH=12.0
# SHORTS_GAMEPLAY_MAX_LENGTH=60.0
#
# --- Disk auto-cleanup ---
# SHORTS_CLIP_RETENTION_DAYS=30       # delete media older than N days
# SHORTS_MAX_KEEP_CLIPS=200           # keep at most N rendered clips
# SHORTS_PUBLISHED_ARCHIVE=outputs/archive  # move published clips here
#
# --- Scheduled publishing ---
# SHORTS_PUBLISH_AT=                  # ISO-8601 time (UTC) to delay publishing, empty = publish now
# SHORTS_PUBLISH_INTERVAL=30          # scheduler poll interval in seconds
#
# --- Background music (phonk) ---
# SHORTS_BGM_MODE=off                 # off | music | mix50 | auto
# SHORTS_MUSIC_DIR=D:/shorts_music    # folder with .mp3/.m4a/.ogg/.wav tracks
# SHORTS_BGM_VOLUME=0.30              # bgm loudness (0.0-1.0)
#
# --- LLM Hook Judge (optional, scores hook quality before optimization) ---
# SHORTS_HOOK_JUDGE_ENABLED=false
# SHORTS_HOOK_MIN_SCORE=0.5
